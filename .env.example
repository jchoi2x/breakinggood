# Copy to `.env` and fill in values. Never commit `.env`.
#
#   cp .env.example .env
#
# Site mode and AI-assisted repo mode need at least one provider key.
# `npx breakinggood providers` shows what is active.

# Anthropic (default when set)
ANTHROPIC_API_KEY=

# Optional other providers (see README)
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional overrides
# BREAKINGGOOD_PROVIDER=anthropic
# BREAKINGGOOD_MODEL=claude-opus-5-5
