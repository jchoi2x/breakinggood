# Copy to `.env` and fill in values. Never commit `.env`.
#
#   cp .env.example .env
#
# Site mode and AI-assisted repo mode need at least one provider key.
# `npx breakinggood providers` shows what is active.

# Anthropic (default when set)
ANTHROPIC_API_KEY=

# Optional other providers (see README)
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434

# Cloudflare AI Gateway (--provider aigateway; models use provider/model, e.g. anthropic/claude-sonnet-4-5)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_GATEWAY_ID=default
# CLOUDFLARE_API_TOKEN=
# AI_GATEWAY_PROVIDER_KEY=
# AI_GATEWAY_BASE_URL=
# AI_GATEWAY_DEFAULT_MODEL=anthropic/claude-sonnet-4-5

# Optional overrides
# BREAKINGGOOD_PROVIDER=anthropic
# BREAKINGGOOD_MODEL=claude-opus-5-5
